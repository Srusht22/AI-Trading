# ─── Server-side tooling only (copy to .env.server.local) ─────────────────────
# Used by `npm run owner:assign` and `npm run test:integration`.
# This key BYPASSES Row-Level Security. Keep it off browsers, out of git,
# out of VITE_ variables and out of logs.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-key-here
# Needed by integration tests to act as an ordinary browser client.
SUPABASE_PUBLISHABLE_KEY=paste-your-publishable-or-anon-key-here
# Optional, local stack only: Mailpit API for email-flow tests.
MAILPIT_URL=http://127.0.0.1:54324
# Direct Postgres connection, local stack only: used by type generation
# (DB_URL) and the grant/type consistency test. `supabase status` prints it.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
