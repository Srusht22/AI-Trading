# ─── Browser configuration (copy to .env.local) ───────────────────────────────
# These two values are PUBLIC: they ship inside the website's JavaScript.
# Access to data is enforced by Row-Level Security in the database.
#
# Local stack: run `npx supabase status` and copy "API URL" and the
# publishable / anon key. Hosted project: Dashboard › Project Settings › API.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=paste-your-publishable-or-anon-key-here

# Never put a service-role or secret key in a VITE_ variable — the build refuses it.
