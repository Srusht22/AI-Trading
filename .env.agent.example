# ─── Worker agent credentials (written by `npm run agent:register`) ──────────
# The register script creates .env.agent.local (mode 600) for you; this file
# only documents the format. The token is shown nowhere else and cannot be
# recovered: if it is lost or leaked, run `npm run agent:revoke -- <agent-id>`
# and register a new agent.
TRADEPILOT_API_URL=http://127.0.0.1:8788
TRADEPILOT_AGENT_ID=
TRADEPILOT_AGENT_TOKEN=paste-nothing-here-use-agent-register
# Only when the deployment sits behind Cloudflare Access (staging): a service token.
TRADEPILOT_ACCESS_CLIENT_ID=
TRADEPILOT_ACCESS_CLIENT_SECRET=
